@model List<ASSIGNTMENT.Models.Food>

<h2 class="text-center mt-3">🔍 TÌM KIẾM MÓN ĂN</h2>

<!-- FORM SEARCH -->
<form asp-action="Search" method="get" class="row mb-4">

    <div class="col-md-3">
        <input name="name" class="form-control" placeholder="Tên món ăn" />
    </div>

    <div class="col-md-2">
        <input name="minPrice" class="form-control" placeholder="Giá từ" />
    </div>

    <div class="col-md-2">
        <input name="maxPrice" class="form-control" placeholder="Giá đến" />
    </div>

    <div class="col-md-2">
        <input name="category" class="form-control" placeholder="Loại món" />
    </div>

    <div class="col-md-2">
        <input name="description" class="form-control" placeholder="Mô tả" />
    </div>

    <div class="col-md-1">
        <button class="btn btn-primary w-100">🔍</button>
    </div>

</form>

<hr />

<!-- DANH SÁCH MÓN ĂN -->
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow">

                <img src="~/images/@item.Image"
                     class="card-img-top"
                     style="height:200px; object-fit:cover;" />

                <div class="card-body">
                    <h5>@item.Name</h5>
                    <p class="text-danger fw-bold">@item.Price VNĐ</p>
                    <p>@item.Description</p>

                    <a asp-controller="Food"
                       asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-primary">
                        Xem chi tiết
                    </a>

                    <a asp-controller="Cart"
                       asp-action="Add"
                       asp-route-id="@item.Id"
                       class="btn btn-success">
                        Thêm giỏ
                    </a>
                </div>

            </div>
        </div>
    }
</div>