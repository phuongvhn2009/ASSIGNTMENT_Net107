@model List<ASSIGNTMENT.Models.Food>

<h2>🛒 Giỏ hàng</h2>

<table class="table table-bordered">
    <tr>
        <th>Hình</th>
        <th>Tên</th>
        <th>Giá</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                <img src="~/images/@item.Image" width="60" />
            </td>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>
                <a asp-controller="Cart"
                   asp-action="Remove"
                   asp-route-id="@item.Id"
                   class="btn btn-danger">
                    Xoá
                </a>
            </td>
        </tr>
    }
</table>