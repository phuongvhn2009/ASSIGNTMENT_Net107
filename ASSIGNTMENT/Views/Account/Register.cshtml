@model ASSIGNTMENT.Models.User

@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container d-flex justify-content-center align-items-center" style="height: 80vh;">
    <div class="card shadow p-4" style="width: 450px;">

        <h3 class="text-center mb-4">📝 Đăng ký</h3>

        <form method="post">

            <input asp-for="FullName" class="form-control mb-2" placeholder="Họ tên" required />

            <input asp-for="Email" class="form-control mb-2" placeholder="Email" required />

            <input asp-for="Password" type="password" class="form-control mb-2" placeholder="Mật khẩu" required />

            <input asp-for="Phone" class="form-control mb-2" placeholder="Số điện thoại" />

            <input asp-for="Address" class="form-control mb-2" placeholder="Địa chỉ" />

            <button class="btn btn-success w-100 mt-2">Đăng ký</button>
        </form>

        <hr />

        <p class="text-center">
            Đã có tài khoản?
            <a asp-action="Login" asp-controller="Account">Đăng nhập</a>
        </p>

    </div>
</div>